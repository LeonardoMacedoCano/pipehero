# Copy this file to ".env" and adjust the path below. Works both for
# `docker compose up` and for `npm run dev` directly (e.g. running from
# VS Code) — both read this same file.

# Real folder with your Clone Hero songs (one subfolder per song, each
# with notes.chart or notes.mid + audio + optional song.ini).
# On Docker/Unraid, it's a host path, like:
#   MUSIC_PATH=/mnt/user/guitar-hero-songs
# Running locally (npm run dev/npm start) without Docker, it's the
# normal path on your machine, like (Windows):
#   MUSIC_PATH=C:\Users\your-user\Music\ClonehHeroSongs
# "SONGS_DIR" works as a synonym for "MUSIC_PATH" — use whichever name
# you prefer, it doesn't matter.
MUSIC_PATH=/mnt/user/guitar-hero-songs

# Host port that will point to the game (defaults to 5511 if unset).
# Only used by docker-compose — `npm run dev` always uses fixed 5511.
HOST_PORT=5511
