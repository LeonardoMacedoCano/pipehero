# Copy this file to ".env" and adjust the path below. Works both for
# `docker compose up` and for `npm run dev` directly (e.g. running from
# VS Code) — both read this same file.

# Real folder with your Clone Hero songs (one subfolder per song, each
# with notes.chart or notes.mid + audio + optional song.ini).
# On Docker/Unraid, it's a host path, like:
#   MUSIC_PATH=/mnt/user/guitar-hero-songs
# Running locally (npm run dev/npm start) without Docker, it's the
# normal path on your machine, like (Windows):
#   MUSIC_PATH=C:\Users\your-user\Music\ClonehHeroSongs
# "SONGS_DIR" works as a synonym for "MUSIC_PATH" — use whichever name
# you prefer, it doesn't matter.
# Optional — if unset, docker-compose falls back to the "songs" folder
# inside the project itself (only the bundled synthetic test songs).
MUSIC_PATH=/mnt/user/guitar-hero-songs

# Host port that will point to the game (defaults to 5511 if unset).
# Only used by docker-compose — `npm run dev` always uses fixed 5511.
HOST_PORT=5511

# Port the server listens on INSIDE the container (defaults to 5511 if
# unset). Only change this if 5511 conflicts with something inside the
# container itself — to change the host-facing port, use HOST_PORT above.
PORT=5511

# Path to the pipehero source code (the folder with the Dockerfile),
# used as the build context. Defaults to "." (the same folder as this
# .env file). Only set this if docker-compose.yml lives somewhere else
# than the source code, e.g. Unraid's appdata layout:
#   PIPEHERO_SOURCE_PATH=/mnt/user/appdata/pipehero-src
PIPEHERO_SOURCE_PATH=.

# --- Login with Google (optional) ---
# The three variables below are optional as a group: if any of them is
# missing, the "Log in with Google" button on the main menu stays
# locked (with a hint explaining why) and the rest of the game works
# normally. Full step-by-step in DEPLOY.md.

# Connection string for your existing Postgres server (doesn't spin up
# a new Postgres). Format: postgres://user:password@host:port/db_name
#   DATABASE_URL=postgres://pipehero:password@192.168.1.10:5432/pipehero
DATABASE_URL=

# OAuth Client ID created at https://console.cloud.google.com/apis/credentials
# (type "Web application"). It's public — not a secret — and nothing
# else is needed (no client secret, no redirect URI).
GOOGLE_CLIENT_ID=

# Secret used only to sign the session cookie (HMAC) — generate a
# large random value, e.g. `openssl rand -hex 32`. Changing this value
# later logs everyone out.
SESSION_SECRET=
