{
  "name": "pipehero",
  "version": "0.1.0",
  "description": "Guitar Hero/Clone Hero style rhythm game, playable in the browser, compatible with Clone Hero songs (.chart/.mid).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Leonardo Macedo Cano",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeonardoMacedoCano/pipehero"
  },
  "scripts": {
    "dev": "vite --port 5511",
    "typecheck": "tsc --noEmit",
    "build": "vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server-dist/server.js",
    "test": "tsx scripts/run-unit-tests.ts",
    "test:integration:chart-parsing": "tsx test/integration/chart-parsing.ts",
    "test:integration:render-visual": "tsx test/integration/render-visual.ts",
    "test:integration:gameplay-simulation": "tsx test/integration/gameplay-simulation.ts",
    "test:integration:chords-and-sustains": "tsx test/integration/chords-and-sustains.ts",
    "test:integration:star-power-timing": "tsx test/integration/star-power-timing.ts",
    "test:integration:song-server": "tsx test/integration/song-server.ts",
    "test:integration:auth-server": "tsx test/integration/auth-server.ts",
    "test:integration:achievements-server": "tsx test/integration/achievements-server.ts",
    "test:integration:menu-dom": "tsx test/integration/menu-dom.ts",
    "test:integration:docker-build-simulation": "tsx test/integration/docker-build-simulation.ts",
    "test:integration:real-song-compatibility": "tsx test/integration/real-song-compatibility.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:all": "npm run typecheck && npm test && npm run test:integration",
    "generate-dev-song": "tsx scripts/generate-dev-song.ts",
    "generate-test-chart": "tsx scripts/generate-test-chart.ts",
    "parse-chart": "tsx scripts/parse-chart.ts",
    "postinstall": "patch-package"
  },
  "keywords": [
    "rhythm-game",
    "guitar-hero",
    "clone-hero",
    "browser-game"
  ],
  "dependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lcano-react-ui": "github:LeonardoMacedoCano/lcano-react-ui",
    "parsehero": "^0.0.2",
    "patch-package": "^8.0.1",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.4.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.11"
  }
}
